#!/usr/bin/env python3
"""Battery reader for the Corsair HS80 RGB Wireless headset.

Talks to the wireless dongle directly over hidraw, so it needs no
third-party Python packages. Prints one JSON object on stdout that is
consumed by both the Omarchy shell bar widget and Waybar:

  {"text": "... 94%", "tooltip": "...", "class": "normal", "percentage": 94}

`percentage` is omitted when the headset is powered off or out of range.
"""

import json
import os
import select

VENDOR_ID = 0x1B1C
PRODUCT_ID = 0x0A6B
BATTERY_CMD = [0x02, 0x01, 0x00]
BATTERY_EVENT = 0x0F
READ_TIMEOUT_S = 0.5
MAX_READS = 5


def find_hidraw_paths():
    """Find hidraw devices matching the HS80 VID/PID."""
    paths = []
    base = "/sys/class/hidraw"
    if not os.path.isdir(base):
        return paths

    for entry in os.listdir(base):
        uevent_path = os.path.join(base, entry, "device", "uevent")
        try:
            with open(uevent_path) as f:
                content = f.read()
            # Match HID_ID line: HID_ID=0003:00001B1C:00000A6B
            for line in content.splitlines():
                if line.startswith("HID_ID="):
                    parts = line.split(":")
                    if len(parts) == 3:
                        vid = int(parts[1], 16)
                        pid = int(parts[2], 16)
                        if vid == VENDOR_ID and pid == PRODUCT_ID:
                            paths.append(f"/dev/{entry}")
        except (OSError, ValueError):
            continue

    paths.sort()
    return paths


def get_battery():
    """Query each matching hidraw node until one answers with a battery event."""
    for path in find_hidraw_paths():
        try:
            fd = os.open(path, os.O_RDWR | os.O_NONBLOCK)
        except OSError:
            continue
        try:
            os.write(fd, bytes(BATTERY_CMD + [0] * 62))
            # The dongle may emit other events (e.g. connection status)
            # before the battery response, so read a few times.
            for _ in range(MAX_READS):
                readable, _, _ = select.select([fd], [], [], READ_TIMEOUT_S)
                if not readable:
                    break
                data = os.read(fd, 65)
                if len(data) > 6 and data[3] == BATTERY_EVENT:
                    pct = (data[5] | (data[6] << 8)) / 10
                    if 0 <= pct <= 100:
                        return pct
        except OSError:
            continue
        finally:
            os.close(fd)

    return None


def get_icon(pct):
    if pct >= 80:
        return "\U000f0942"  # 󰥂
    if pct >= 60:
        return "\U000f0941"  # 󰥁
    if pct >= 40:
        return "\U000f0940"  # 󰥀
    if pct >= 20:
        return "\U000f093f"  # 󰤿
    return "\U000f093e"  # 󰤾


def get_css_class(pct):
    if pct <= 15:
        return "critical"
    if pct <= 30:
        return "low"
    return "normal"


def main():
    pct = get_battery()

    if pct is not None:
        icon = get_icon(pct)
        output = {
            "text": f"{icon} {pct:.0f}%",
            "tooltip": f"Corsair HS80 Battery: {pct:.0f}%",
            "class": get_css_class(pct),
            "percentage": round(pct),
        }
    else:
        output = {
            "text": "\U000f02ce --",  # 󰋎
            "tooltip": "Corsair HS80: not connected",
            "class": "unavailable",
        }

    print(json.dumps(output))


if __name__ == "__main__":
    main()
